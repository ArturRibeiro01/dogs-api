    {
      "_id": "req_supabase_login",
      "_type": "request",
      "parentId": "fld_supabase_auth",
      "modified": 1780709400000,
      "created": 1780709400000,
      "url": "{{ _.supabase_url }}/auth/v1/token?grant_type=password",
      "name": "POST password login",
      "description": "Obtém access_token no Supabase Auth. Copie response.access_token para a variável access_token do ambiente.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.auth_email }}\",\n  \"password\": \"{{ _.auth_password }}\"\n}"
      },
      "parameters": [],
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "apikey",
          "value": "{{ _.supabase_anon_key }}"
        },
        {
          "name": "Authorization",
          "value": "Bearer {{ _.supabase_anon_key }}"
        }
      ],
      "authentication": {},
      "scripts": {
        "afterResponse": "insomnia.test('Supabase login returned access token', () => {\n  insomnia.expect(insomnia.response.code).to.eql(200);\n\n  const jsonBody = insomnia.response.json();\n  insomnia.expect(jsonBody.access_token).to.be.a('string');\n\n  insomnia.environment.set('access_token', jsonBody.access_token);\n\n  if (jsonBody.refresh_token) {\n    insomnia.environment.set('refresh_token', jsonBody.refresh_token);\n  }\n});"
      },
      "metaSortKey": 100
    },
